{
  "name": "folder-sync",
  "author": "lumine-code",
  "description": "One-way folder synchronization from the tree view.",
  "repository": "https://github.com/lumine-code/folder-sync",
  "bugs": {
    "url": "https://github.com/lumine-code/folder-sync/issues"
  },
  "keywords": [
    "backup",
    "copy",
    "mirror",
    "one-way",
    "deploy"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "main": "./lib/main",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "configSchema": {
    "storagePath": {
      "title": "Storage Path",
      "description": "Base directory for sync targets. Target path is built as storagePath/name.",
      "type": "string",
      "default": ""
    }
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "consumedServices": {
    "tree-view.selection": {
      "versions": {
        "^1.0.0": "consumeTreeViewSelection"
      }
    },
    "open-external": {
      "versions": {
        "^1.0.0": "consumeOpenExternal"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
