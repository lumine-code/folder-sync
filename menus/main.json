{
  "context-menu": {
    ".tree-view .full-menu:not(.multi-select) .file[data-name=\".sync\"]": [
      {
        "type": "separator"
      },
      {
        "label": "Sync Folder",
        "afterGroupContaining": [
          {
            "id": "terminal:tree-context"
          },
          "tree-view-favourite:add",
          "tree-view-favourite:remove",
          "diff-view:enable",
          "jupyter-cells:import-notebook",
          "jupyter-view:open-source",
          "graviss:open-source-on-right",
          "markdown-preview:preview-file",
          "image-editor:open-in-new-tab",
          "search-panel:project-show-in-current-directory",
          "open-external:show",
          "tree-view:open-selected-entry-up",
          "native-clip:paste",
          "tree-view:paste",
          "tree-view:remove",
          "tree-view:add-file"
        ],
        "command": "folder-sync:run"
      },
      {
        "label": "Open Target",
        "command": "folder-sync:open"
      },
      {
        "type": "separator"
      }
    ],
    ".tree-view .full-menu:not(.multi-select) .directory": [
      {
        "type": "separator"
      },
      {
        "label": "Create .sync",
        "afterGroupContaining": [
          {
            "id": "terminal:tree-context"
          },
          "tree-view-favourite:add",
          "tree-view-favourite:remove",
          "diff-view:enable",
          "jupyter-cells:import-notebook",
          "jupyter-view:open-source",
          "graviss:open-source-on-right",
          "markdown-preview:preview-file",
          "image-editor:open-in-new-tab",
          "search-panel:project-show-in-current-directory",
          "open-external:show",
          "tree-view:open-selected-entry-up",
          "native-clip:paste",
          "tree-view:paste",
          "tree-view:remove",
          "tree-view:add-file"
        ],
        "command": "folder-sync:create"
      },
      {
        "type": "separator"
      }
    ]
  },
  "menu": [
    {
      "label": "Packages",
      "submenu": [
        {
          "label": "Folder Sync",
          "submenu": [
            {
              "label": "Create .sync",
              "command": "folder-sync:create"
            },
            {
              "label": "Sync Folder",
              "command": "folder-sync:run"
            },
            {
              "label": "Open Target",
              "command": "folder-sync:open"
            }
          ]
        }
      ]
    }
  ]
}
